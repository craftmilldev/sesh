{
  "name": "@sesh/web",
  "version": "0.1.0",
  "private": true,
  "description": "sesh HTTP app: landing page, sign-in and the org shell. Deployed to Vercel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "start": "tsx scripts/dev.ts",
    "test": "vitest run",
