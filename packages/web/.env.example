# Locally, this is the Postgres from `npm run db:up` (docker-compose.yml). Required.
# On Vercel, set these from Neon → Connect. `npm run build` applies pending migrations, so a deploy migrates the
# database itself (a failing migration fails the build and the previous deployment stays live):
#   DATABASE_URL_UNPOOLED  direct connection, what the build migrates (falls back to DATABASE_URL)
#   DATABASE_URL           Neon's pooled connection (host has `-pooler`); the server uses it unless DATABASE_URL_POOLED is set
DATABASE_URL=postgres://postgres:postgres@localhost:54330/sesh
DATABASE_URL_POOLED=

# Tests create a throwaway database per test file on this server (default: the `npm run db:up` Postgres).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54330/postgres

# Signs session tokens (JWTs). Required. Generate with `openssl rand -hex 32`. Changing it logs everyone out.
TOKEN_SECRET=

# Login codes are emailed with Resend. Leave RESEND_API_KEY unset locally to print them to the console.
RESEND_API_KEY=
# The From address of those emails; its domain must be verified in Resend. Required when RESEND_API_KEY is set.
EMAIL_FROM=

# Optional. PostHog product metrics (landing and login events, sign-ups, rejected codes). Unset sends nothing.
# POSTHOG_HOST defaults to Craftmill's shared proxy (https://a.craftmill.dev/api/ingest); set it to send elsewhere.
POSTHOG_API_KEY=
POSTHOG_HOST=

PORT=3000
