{
  "name": "sesh",
  "version": "0.1.0",
  "private": true,
  "description": "Session insights for Claude Code teams: org session logging from OTel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @sesh/web",
    "start": "npm run start -w @sesh/web",
    "db:up": "docker compose -p sesh up -d --wait",
    "db:down": "docker compose -p sesh down",
    "db:migrate": "npm run db:migrate -w @sesh/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
