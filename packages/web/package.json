    "build": "tsx scripts/build.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "posthog-node": "^5.55.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
